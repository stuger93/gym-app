# Copiar este archivo a ".env" y ajustar los valores localmente.
# .env nunca se sube a git (ver .gitignore).

POSTGRES_USER=gymapp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gymapp
POSTGRES_PORT=5432

DATABASE_URL=postgresql://gymapp:changeme@db:5432/gymapp

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Autenticación
JWT_SECRET_KEY=changeme
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
VITE_API_URL=http://localhost:8000

# Seed del usuario admin (solo para desarrollo local, correr con: docker compose exec backend python -m app.seed)
ADMIN_EMAIL=admin@gymapp.com
ADMIN_PASSWORD=changeme
